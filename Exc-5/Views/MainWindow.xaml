<Window x:Class="Exc_5.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Exc_5.ViewModels"
        Title="Student Registration - MVVM" Height="500" Width="850"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Form Input -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Form Mahasiswa" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="NIM:" Margin="0,4,0,2"/>
            <TextBox Text="{Binding NimInput, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

            <TextBlock Text="Nama Lengkap:" Margin="0,8,0,2"/>
            <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

            <TextBlock Text="Jurusan:" Margin="0,8,0,2"/>
            <TextBox Text="{Binding MajorInput, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

            <TextBlock Text="Email:" Margin="0,8,0,2"/>
            <TextBox Text="{Binding EmailInput, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>

            <WrapPanel Margin="0,16,0,0">
                <Button Content="Tambah" Command="{Binding SaveCommand}" Width="60" Margin="0,0,6,6" Padding="4"/>
                <Button Content="Ubah" Command="{Binding UpdateCommand}" Width="60" Margin="0,0,6,6" Padding="4"/>
                <Button Content="Hapus" Command="{Binding DeleteCommand}" Width="60" Margin="0,0,6,6" Padding="4"/>
                <Button Content="Reset" Command="{Binding ClearCommand}" Width="60" Margin="0,0,0,6" Padding="4"/>
            </WrapPanel>
        </StackPanel>

        <!-- DataGrid Mahasiswa -->
        <DataGrid Grid.Column="2" 
                  ItemsSource="{Binding Students}" 
                  SelectedItem="{Binding SelectedStudent}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="100"/>
                <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="Jurusan" Binding="{Binding Major}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>