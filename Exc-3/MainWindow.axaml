<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Exc_3.MainWindow"
        Title="Kalkulator"
        Width="500" Height="720"
        MinWidth="380" MinHeight="550"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        KeyDown="OnWindowKeyDown"
        TextInput="OnWindowTextInput">

    <Viewbox Stretch="Uniform">
        <Grid Width="460" Height="680" RowDefinitions="Auto,*" Margin="20">
            
            <Border Grid.Row="0" 
                    Background="#252526" 
                    CornerRadius="16" 
                    Padding="20" 
                    Margin="0,0,0,20" 
                    Height="140">
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock x:Name="TextRiwayat" 
                               Text="" 
                               Foreground="#9e9e9e" 
                               FontSize="22" 
                               HorizontalAlignment="Right" 
                               Height="30"/>
                    <TextBlock x:Name="TextLayar" 
                               Text="0" 
                               Foreground="#ffffff" 
                               FontSize="56" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Right" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*">

                <Button Grid.Row="0" Grid.Column="0" Content="C" Click="OnClearClick" Background="#d32f2f" Foreground="White"/>
                <Button Grid.Row="0" Grid.Column="1" Content="⌫" Click="OnBackspaceClick" Background="#3a3a3c" Foreground="White"/>
                <Button Grid.Row="0" Grid.Column="2" Content="%" Click="OnOperatorClick" Background="#3a3a3c" Foreground="White"/>
                <Button Grid.Row="0" Grid.Column="3" Content="÷" Click="OnOperatorClick" Background="#f57c00" Foreground="White" Tag="/"/>

                <Button Grid.Row="1" Grid.Column="0" Content="7" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="7"/>
                <Button Grid.Row="1" Grid.Column="1" Content="8" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="8"/>
                <Button Grid.Row="1" Grid.Column="2" Content="9" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="9"/>
                <Button Grid.Row="1" Grid.Column="3" Content="×" Click="OnOperatorClick" Background="#f57c00" Foreground="White" Tag="*"/>

                <Button Grid.Row="2" Grid.Column="0" Content="4" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="4"/>
                <Button Grid.Row="2" Grid.Column="1" Content="5" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="5"/>
                <Button Grid.Row="2" Grid.Column="2" Content="6" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="6"/>
                <Button Grid.Row="2" Grid.Column="3" Content="-" Click="OnOperatorClick" Background="#f57c00" Foreground="White" Tag="-"/>

                <Button Grid.Row="3" Grid.Column="0" Content="1" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="1"/>
                <Button Grid.Row="3" Grid.Column="1" Content="2" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="2"/>
                <Button Grid.Row="3" Grid.Column="2" Content="3" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="3"/>
                <Button Grid.Row="3" Grid.Column="3" Content="+" Click="OnOperatorClick" Background="#f57c00" Foreground="White" Tag="+"/>

                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="0"/>
                <Button Grid.Row="4" Grid.Column="2" Content="." Click="OnAngkaClick" Background="#2c2c2e" Foreground="White" Tag="."/>
                <Button Grid.Row="4" Grid.Column="3" Content="=" Click="OnSamaDenganClick" Background="#2e7d32" Foreground="White"/>
            </Grid>
        </Grid>
    </Viewbox>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
    </Window.Styles>
</Window>