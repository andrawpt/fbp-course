<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Exc_6.ViewModels"
        xmlns:models="using:Exc_6.Models"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
        x:Class="Exc_6.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Student Registration"
        Width="1180" Height="740"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#1B1C20">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#18191E" />
            <Setter Property="BorderBrush" Value="#2E303A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EDEDF0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2A2B33" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="BorderBrush" Value="#373944" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333540" />
            <Setter Property="Foreground" Value="#60A5FA" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2A2B33" />
            <Setter Property="Foreground" Value="#EDEDF0" />
            <Setter Property="BorderBrush" Value="#373944" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333540" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#2A2B33" />
            <Setter Property="Foreground" Value="#FB7185" />
            <Setter Property="BorderBrush" Value="#373944" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333540" />
            <Setter Property="Foreground" Value="#FDA4AF" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9B9EA7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#25262E" />
            <Setter Property="BorderBrush" Value="#32343F" />
            <Setter Property="Foreground" Value="#EDEDF0" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#202127" />
            <Setter Property="Foreground" Value="#8E92A0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="SeparatorBrush" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#292A33" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#DCDFE5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.status-dot-ok">
            <Setter Property="Background" Value="#10B981" />
        </Style>
        <Style Selector="Border.status-dot-err">
            <Setter Property="Background" Value="#F43F5E" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" 
                Background="#202127" 
                BorderBrush="#2A2B33" 
                BorderThickness="0,0,0,1" 
                Padding="24,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Student Registration" 
                               FontSize="17" 
                               FontWeight="SemiBold" 
                               Foreground="#EDEDF0" 
                               LetterSpacing="-0.3" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#18191E" 
                            BorderBrush="#2E303A" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10,5">
                        <TextBlock Text="{Binding Students.Count, StringFormat='{}{0} Terdaftar'}" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="#9B9EA7" />
                    </Border>
                    <Button Content="Refresh Data" 
                            Command="{Binding RefreshDataCommand}" 
                            Classes="ghost" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" Margin="20,18,20,16">
            <Border Grid.Column="0" 
                    Background="#23242A" 
                    CornerRadius="10" 
                    Padding="20" 
                    Margin="0,0,16,0"
                    BorderBrush="#2F313A" 
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" 
                                       Text="Formulir Mahasiswa" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#EDEDF0" 
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" 
                                    Background="#18191E" 
                                    BorderBrush="#2E303A" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Padding="8,3">
                                <TextBlock Text="{Binding Id, StringFormat='#{0}'}" 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           Foreground="#8E92A0" />
                            </Border>
                        </Grid>

                        <Separator Background="#2A2B33" Height="1" Margin="0,-4,0,-4" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="NIM" FontSize="12" FontWeight="Medium" Foreground="#9B9EA7" />
                            <TextBox Text="{Binding Nim, Mode=TwoWay}" PlaceholderText="Contoh: 220101001" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Nama Lengkap" FontSize="12" FontWeight="Medium" Foreground="#9B9EA7" />
                            <TextBox Text="{Binding FullName, Mode=TwoWay}" PlaceholderText="Contoh: Ahmad Dahlan" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Jurusan" FontSize="12" FontWeight="Medium" Foreground="#9B9EA7" />
                            <TextBox Text="{Binding Major, Mode=TwoWay}" PlaceholderText="Contoh: Teknik Informatika" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Email" FontSize="12" FontWeight="Medium" Foreground="#9B9EA7" />
                            <TextBox Text="{Binding Email, Mode=TwoWay}" PlaceholderText="Contoh: ahmad@kampus.ac.id" />
                        </StackPanel>

                        <StackPanel Spacing="10" Margin="0,10,0,0">
                            <Button Content="Daftar Baru" 
                                    Command="{Binding AddStudentCommand}" 
                                    Classes="primary"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Height="36" />

                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" 
                                        Content="Update" 
                                        Command="{Binding UpdateStudentCommand}" 
                                        Classes="secondary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Height="34" />
                                <Button Grid.Column="2" 
                                        Content="Hapus" 
                                        Command="{Binding DeleteStudentCommand}" 
                                        Classes="danger"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Height="34" />
                            </Grid>

                            <Button Content="Bersihkan Formulir" 
                                    Command="{Binding ClearFormCommand}" 
                                    Classes="ghost"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" 
                    Background="#23242A" 
                    CornerRadius="10" 
                    BorderBrush="#2F313A" 
                    BorderThickness="1" 
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" 
                            Background="#202127" 
                            BorderBrush="#2A2B33" 
                            BorderThickness="0,0,0,1" 
                            Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" 
                                       Text="Data Terdaftar" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#EDEDF0" 
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" 
                                       Text="Pilih baris untuk mengedit" 
                                       FontSize="11" 
                                       Foreground="#6C707E" 
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Students}" 
                              SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#282932"
                              Background="Transparent"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding Id}" 
                                                Width="55" />
                            <DataGridTextColumn Header="NIM" 
                                                Binding="{Binding Nim}" 
                                                Width="110" />
                            <DataGridTextColumn Header="Nama Lengkap" 
                                                Binding="{Binding FullName}" 
                                                Width="*" />
                            <DataGridTextColumn Header="Jurusan" 
                                                Binding="{Binding Major}" 
                                                Width="150" />
                            <DataGridTextColumn Header="Email" 
                                                Binding="{Binding Email}" 
                                                Width="190" />
                            <DataGridTextColumn Header="Tgl Registrasi" 
                                                Binding="{Binding RegistrationDate, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" 
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" 
                Background="#18191D" 
                BorderBrush="#26272F" 
                BorderThickness="0,1,0,0" 
                Padding="20,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" 
                        Width="8" Height="8" 
                        CornerRadius="4" 
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Classes.status-dot-ok="{Binding IsSuccess}"
                        Classes.status-dot-err="{Binding !IsSuccess}" />

                <TextBlock Grid.Column="1" 
                           Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           Foreground="#9B9EA7" 
                           TextTrimming="CharacterEllipsis" 
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" 
                           Text="SQL Server • Port 1433" 
                           FontSize="11" 
                           Foreground="#5D606E" 
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
