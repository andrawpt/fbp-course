<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Exc_4"
        x:Class="Exc_4.MainWindow"
        Title="Sistem Database Mahasiswa"
        Width="1100" Height="720"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid ColumnDefinitions="340,*" Margin="24">
        
        <Border Grid.Column="0" 
                Background="#FFFFFF" 
                CornerRadius="12" 
                Padding="24" 
                Margin="0,0,20,0"
                BorderBrush="#E2E8F0" 
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto">
                
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Entri Mahasiswa" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#0F172A"/>
                    <TextBlock Text="Kelola data akademik mahasiswa" 
                               FontSize="13" 
                               Foreground="#64748B" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="16">
                        <StackPanel>
                            <TextBlock Text="NIM" 
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       Foreground="#334155" 
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNim" 
                                     PlaceholderText="Contoh: 5025211001" 
                                     Height="36" 
                                     CornerRadius="6"
                                     Background="#FFFFFF" 
                                     Foreground="#0F172A" 
                                     BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Nama Lengkap" 
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       Foreground="#334155" 
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNama" 
                                     PlaceholderText="Nama lengkap mahasiswa" 
                                     Height="36" 
                                     CornerRadius="6"
                                     Background="#FFFFFF" 
                                     Foreground="#0F172A" 
                                     BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Program Studi" 
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       Foreground="#334155" 
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtJurusan" 
                                     PlaceholderText="Teknik Informatika" 
                                     Height="36" 
                                     CornerRadius="6"
                                     Background="#FFFFFF" 
                                     Foreground="#0F172A" 
                                     BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="IPK" 
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       Foreground="#334155" 
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtIpk" 
                                     PlaceholderText="0.00 - 4.00" 
                                     Height="36" 
                                     CornerRadius="6"
                                     Background="#FFFFFF" 
                                     Foreground="#0F172A" 
                                     BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <Button x:Name="BtnTambah" 
                            Content="Tambah Mahasiswa" 
                            Click="BtnTambah_Click"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Height="38" 
                            CornerRadius="6" 
                            Background="#0F172A" 
                            Foreground="#FFFFFF" 
                            FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" 
                                x:Name="BtnUbah" 
                                Content="Simpan" 
                                Click="BtnUbah_Click"
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                Height="36" 
                                Margin="0,0,4,0" 
                                CornerRadius="6" 
                                Background="#F1F5F9" 
                                Foreground="#0F172A" 
                                BorderBrush="#CBD5E1" 
                                BorderThickness="1"/>

                        <Button Grid.Column="1" 
                                x:Name="BtnHapus" 
                                Content="Hapus" 
                                Click="BtnHapus_Click"
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                Height="36" 
                                Margin="4,0,0,0" 
                                CornerRadius="6" 
                                Background="#FFFFFF" 
                                Foreground="#64748B" 
                                BorderBrush="#E2E8F0" 
                                BorderThickness="1"/>
                    </Grid>

                    <Button x:Name="BtnReset" 
                            Content="Kosongkan Form" 
                            Click="BtnReset_Click"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Height="32" 
                            CornerRadius="6" 
                            Background="Transparent" 
                            Foreground="#64748B"/>

                    <TextBlock x:Name="TxtStatus" 
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               Foreground="#64748B"
                               HorizontalAlignment="Center" 
                               TextAlignment="Center" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,16">
                <Border Grid.Column="0" 
                        Background="#FFFFFF" 
                        CornerRadius="8" 
                        Padding="16,14" 
                        Margin="0,0,12,0"
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOTAL MAHASISWA" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTotalMahasiswa" 
                                   Text="0" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#0F172A" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" 
                        Background="#FFFFFF" 
                        CornerRadius="8" 
                        Padding="16,14" 
                        Margin="0,0,12,0"
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="RATA-RATA IPK" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="TxtAvgIpk" 
                                   Text="0.00" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#0F172A" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" 
                        Background="#FFFFFF" 
                        CornerRadius="8" 
                        Padding="16,14"
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="IPK TERTINGGI" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="TxtMaxIpk" 
                                   Text="0.00" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#0F172A" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" 
                    Background="#FFFFFF" 
                    CornerRadius="8" 
                    Padding="8" 
                    Margin="0,0,0,16"
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1">
                <TextBox x:Name="TxtSearch" 
                         PlaceholderText="Cari berdasarkan NIM atau Nama mahasiswa..."
                         Background="#FFFFFF" 
                         Foreground="#0F172A" 
                         BorderThickness="0"
                         Height="34"
                         TextChanged="TxtSearch_TextChanged"/>
            </Border>

            <Border Grid.Row="2" 
                    Background="#FFFFFF" 
                    CornerRadius="8" 
                    Padding="8"
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1">
                <DataGrid x:Name="GridMahasiswa"
                          x:DataType="local:Mahasiswa"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="48"
                          Background="#FFFFFF"
                          Foreground="#0F172A"
                          BorderThickness="0"
                          SelectionChanged="GridMahasiswa_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Mahasiswa" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:Mahasiswa">
                                    <StackPanel Orientation="Horizontal" 
                                                VerticalAlignment="Center" 
                                                Spacing="12" 
                                                Margin="8,0">
                                        <Border Background="{Binding AvatarBgColor}" 
                                                CornerRadius="16" 
                                                Width="32" 
                                                Height="32">
                                            <TextBlock Text="{Binding Inisial}" 
                                                       Foreground="#FFFFFF" 
                                                       FontWeight="Bold" 
                                                       FontSize="11"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nama}" 
                                                       FontWeight="Medium" 
                                                       FontSize="13" 
                                                       Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Nim}" 
                                                       FontSize="11" 
                                                       Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Program Studi" 
                                            Binding="{Binding Jurusan}" 
                                            Width="170"/>

                        <DataGridTextColumn Header="IPK" 
                                            Binding="{Binding Ipk, StringFormat={}{0:F2}}" 
                                            Width="70"/>

                        <DataGridTemplateColumn Header="Predikat" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:Mahasiswa">
                                    <Border Background="{Binding IpkBadgeBg}" 
                                            CornerRadius="6" 
                                            Padding="8,3" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center"
                                            Margin="8,0">
                                        <TextBlock Text="{Binding StatusIpk}" 
                                                   Foreground="{Binding IpkBadgeFg}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>